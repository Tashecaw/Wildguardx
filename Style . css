body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f4f5ed;
    color: #233b2c;
}

header {
    background-color: #173d30;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin-top: 0;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
}

nav a:hover {
    color: #b8d6a5;
}

.hero {
    background-color: #dce8d3;
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 40px;
}

.button {
    display: inline-block;
    background-color: #173d30;
    color: white;
    padding: 12px 20px;
    text-decoration: none;
    margin-top: 15px;
    border-radius: 5px;
}

.button:hover {
    background-color: #2c6047;
}

section {
    padding: 40px 20px;
}

section h2 {
    text-align: center;
}

.about p {
    max-width: 700px;
    margin: auto;
    line-height: 1.8;
}

#search {
    display: block;
    width: 80%;
    max-width: 400px;
    padding: 12px;
    margin: 20px auto;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.animal-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    max-width: 900px;
    margin: 30px auto;
}

.animal-card {
    background-color: white;
    padding: 15px;
    border-radius: 8px;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
}

.animal-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 5px;
}

.animal-card h3 {
    color: #24563b;
}

.animal-card p {
    line-height: 1.6;
}

.help {
    background-color: #e4ebdd;
}

.help ul {
    max-width: 600px;
    margin: auto;
    line-height: 2;
}

footer {
    background-color: #173d30;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 600px) {
    .animal-container {
        grid-template-columns: 1fr;
    }

    .hero h2 {
        font-size: 30px;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }
}